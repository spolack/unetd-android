From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <spolack+claude@mailbox.org>
Date: Tue, 29 Sep 2026 10:31:11 +0000
Subject: [PATCH] wg-user: allow the UAPI socket directory to be set at runtime

The directory was baked in at build time via RUNSTATEDIR. That does not work
where the path is only known at runtime, such as an Android app's cache
directory -- which is also not a constant, since it lives under /data/user/<id>
for secondary users and work profiles.

Add wg_user_socket_dir, defaulting to the previous value, and a -S option to
set it. The shared path helper also checks snprintf() for truncation, which the
open-coded callers did not: sun_path is 108 bytes and a long directory silently
produced a truncated socket name.
Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PVGaNeNhqp11rTLwZ9rM4J
---
 main.c    |  5 ++++-
 wg-user.c | 24 +++++++++++++++++++++---
 wg.h      |  1 +
 3 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/main.c b/main.c
index cf8b1c3..3b70a9e 100644
--- a/main.c
+++ b/main.c
@@ -177,7 +177,7 @@ int main(int argc, char **argv)
 	const char *unix_socket = NULL;
 	int ch;
 
-	while ((ch = getopt(argc, argv, "D:dh:u:M:N:P:")) != -1) {
+	while ((ch = getopt(argc, argv, "D:dh:u:M:N:P:S:")) != -1) {
 		switch (ch) {
 		case 'D':
 			data_dir = optarg;
@@ -203,6 +203,9 @@ int main(int argc, char **argv)
 		case 'P':
 			global_pex_port = atoi(optarg);
 			break;
+		case 'S':
+			wg_user_socket_dir = optarg;
+			break;
 		case 'u':
 			unix_socket = optarg;
 			break;
diff --git a/wg-user.c b/wg-user.c
index e90b715..6034cd6 100644
--- a/wg-user.c
+++ b/wg-user.c
@@ -22,9 +22,27 @@
 #include <netdb.h>
 #include "unetd.h"
 
-#define SOCK_PATH RUNSTATEDIR "/wireguard/"
 #define SOCK_SUFFIX ".sock"
 
+/*
+ * Directory holding the userspace WireGuard UAPI sockets. Overridable at
+ * runtime because the location is not always a build-time constant (e.g.
+ * an Android app's cache directory, which also varies per Android user id).
+ */
+const char *wg_user_socket_dir = RUNSTATEDIR "/wireguard";
+
+static int wg_user_sock_path(char *buf, size_t buf_len, struct network *net)
+{
+	int ret;
+
+	ret = snprintf(buf, buf_len, "%s/%s" SOCK_SUFFIX, wg_user_socket_dir,
+		       network_name(net));
+	if (ret < 0 || (size_t)ret >= buf_len)
+		return -1;
+
+	return 0;
+}
+
 struct wg_req {
 	FILE *f;
 
@@ -87,7 +105,7 @@ static bool wg_user_check(struct network *net)
 	struct stat sbuf;
 	int fd, ret;
 
-	if (snprintf(addr.sun_path, sizeof(addr.sun_path), SOCK_PATH "%s" SOCK_SUFFIX, network_name(net)) < 0)
+	if (wg_user_sock_path(addr.sun_path, sizeof(addr.sun_path), net) < 0)
 		return false;
 	if (stat(addr.sun_path, &sbuf) < 0)
 		return false;
@@ -114,7 +132,7 @@ static FILE *wg_user_file(struct network *net)
 	FILE *f = NULL;
 
 	errno = EINVAL;
-	ret = snprintf(addr.sun_path, sizeof(addr.sun_path), SOCK_PATH "%s" SOCK_SUFFIX, network_name(net));
+	ret = wg_user_sock_path(addr.sun_path, sizeof(addr.sun_path), net);
 	if (ret < 0)
 		goto out;
 	ret = stat(addr.sun_path, &sbuf);
diff --git a/wg.h b/wg.h
index e8dc349..b3f4f7e 100644
--- a/wg.h
+++ b/wg.h
@@ -37,6 +37,7 @@ struct wg {
 	const struct wg_ops *ops;
 };
 
+extern const char *wg_user_socket_dir;
 extern const struct wg_ops wg_user_ops;
 #ifdef WG_LINUX_SUPPORT
 extern const struct wg_ops wg_linux_ops;
