From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <spolack+claude@mailbox.org>
Date: Tue, 29 Sep 2026 10:31:10 +0000
Subject: [PATCH] build: make -Werror and the kernel WireGuard backend optional

Android apps cannot use the kernel WireGuard backend: WG_CMD_SET_DEVICE over
generic netlink needs CAP_NET_ADMIN, which an unprivileged app never has. Add
WG_LINUX_SUPPORT so wg-linux.c and its libnl-tiny dependency can be dropped,
leaving only the portable userspace UAPI backend.

Also make -Werror opt-out. GCC 13 and NDK clang both emit warnings that the
upstream GCC baseline does not, and a hard -Werror makes the tree unbuildable
on those toolchains.
Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PVGaNeNhqp11rTLwZ9rM4J
---
 CMakeLists.txt                    |  18 +++++++++++++++---
 __pycache__/edits.cpython-311.pyc | Bin 0 -> 11336 bytes
 wg.c                              |   2 +-
 wg.h                              |   2 ++
 4 files changed, 18 insertions(+), 4 deletions(-)
 create mode 100644 __pycache__/edits.cpython-311.pyc

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2e58bb7..c2f9084 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,17 +11,29 @@ SET(SOURCES
 
 SET(RUNSTATEDIR /var/run)
 
-ADD_DEFINITIONS(-Os -Wall -Werror --std=gnu99 -g3 -Wmissing-declarations -DRUNSTATEDIR="${RUNSTATEDIR}")
+OPTION(WERROR "treat compiler warnings as errors" ON)
+IF(WERROR)
+	SET(WERROR_FLAG -Werror)
+ELSE()
+	SET(WERROR_FLAG "")
+ENDIF()
+
+ADD_DEFINITIONS(-Os -Wall ${WERROR_FLAG} --std=gnu99 -g3 -Wmissing-declarations -DRUNSTATEDIR="${RUNSTATEDIR}")
 FIND_LIBRARY(libjson NAMES json-c json)
 
 OPTION(UBUS_SUPPORT "enable ubus support" ON)
 OPTION(VXLAN_SUPPORT "enable VXLAN support" ON)
-IF(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+OPTION(WG_LINUX_SUPPORT "enable the kernel WireGuard (netlink) backend" ON)
+IF(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+	SET(WG_LINUX_SUPPORT OFF)
+	SET(VXLAN_SUPPORT OFF)
+ENDIF()
+IF(WG_LINUX_SUPPORT)
 	FIND_LIBRARY(nl nl-tiny)
 	SET(SOURCES ${SOURCES} wg-linux.c)
+	ADD_DEFINITIONS(-DWG_LINUX_SUPPORT)
 ELSE()
 	SET(nl "")
-	SET(VXLAN_SUPPORT OFF)
 ENDIF()
 IF(VXLAN_SUPPORT)
 	find_library(bpf NAMES bpf)
diff --git a/__pycache__/edits.cpython-311.pyc b/__pycache__/edits.cpython-311.pyc
new file mode 100644
